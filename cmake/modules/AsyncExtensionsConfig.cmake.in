@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

list(APPEND CMAKE_MODULE_PATH "${CMAKE_CURRENT_LIST_DIR}")

find_dependency(SwiftCollections)
find_dependency(SwiftAtomics)

include("${CMAKE_CURRENT_LIST_DIR}/AsyncExtensionsTargets.cmake")

check_required_components(AsyncExtensions)
